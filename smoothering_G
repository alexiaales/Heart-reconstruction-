import os
from pathlib import Path
import cv2


def process_and_render_medical_model(
    input_file_path: str,
    output_image_path: str = r"C:\Users\Public\smoothed_shiny_render.png",
):
    """Loads a PNG image, applies Gaussian blur filtering to smooth the image,"""
    # 1. Handle file path safely
    file_path = Path(input_file_path)
    if not file_path.exists():
        raise FileNotFoundError(f"Could not find input file at: {file_path}")

    print(f"Loading image from: {file_path}...")
    img = cv2.imread(str(file_path))

    # 2. Apply Gaussian Filtering
    # (15, 15) is the kernel size (must be odd numbers).
    # Increase to (21, 21) for stronger smoothing, or decrease to (7, 7) for lighter smoothing.
    print("Applying Gaussian filtering...")
    smoothed_img = cv2.GaussianBlur(img, (15, 15), 0)

    # 3. Save output image
    cv2.imwrite(output_image_path, smoothed_img)

    # Print output location
    abs_path = os.path.abspath(output_image_path)
    print("\n" + "=" * 50)
    print(f" SUCCESS! File saved to:\n {abs_path}")
    print("=" * 50 + "\n")
    
if __name__ == "__main__":
